# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
# Keep DEBUG off everywhere except a trusted local machine. DEBUG=True leaks
# tracebacks, settings, and the URLconf on any error.
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Set True in production (behind TLS) to force HTTPS + secure cookies + HSTS.
SECURE_SSL=False

# --- CORS (frontend origins, comma-separated) ---
CORS_ALLOWED_ORIGINS=https://webrand-flame.vercel.app,http://localhost:5173,http://localhost:5174

# --- Database ---
# Local dev defaults to SQLite if unset. In prod set a Postgres URL:
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Telegram (get a NEW token from @BotFather — the old VITE_ one is leaked) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: separate chat for job applications (kind=application)
TELEGRAM_APPLICATIONS_CHAT_ID=
